# Worker do Windmill com o ambiente dos pipelines (Python 3.12, dbt, psycopg) em /opt/venv. Build context: pipelines/.
FROM ghcr.io/windmill-labs/windmill:1.876.1
COPY --from=ghcr.io/astral-sh/uv:0.9.7 /uv /usr/local/bin/uv
ENV UV_PROJECT_ENVIRONMENT=/opt/venv UV_PYTHON_INSTALL_DIR=/opt/python UV_LINK_MODE=copy
WORKDIR /opt/pipelines
COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --frozen --no-install-project && chmod -R a+rX /opt/venv /opt/python
WORKDIR /
