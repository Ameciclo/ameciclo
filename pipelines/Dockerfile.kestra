# Kestra do jeito padrão da documentação: a imagem oficial, rodando como root e com acesso ao Docker do servidor
# (/var/run/docker.sock), para que cada passo rode num container próprio (task runner Docker). O Python e o dbt
# ficam nos containers dos passos, não aqui. Só a configuração é acrescentada à imagem.
# Build context: a pasta pipelines/.
FROM kestra/kestra:v2.0.8
USER root
COPY kestra/application.yaml /app/confs/application.yaml
RUN mkdir -p /app/storage
# --no-tutorials: o modo standalone carrega os fluxos de exemplo (namespace tutorial) a cada início e ignora o
# kestra.tutorial-flows.enabled do application.yaml; apagados na interface, eles voltavam no próximo deploy.
CMD ["server", "standalone", "--no-tutorials", "--config", "/app/confs/application.yaml"]
