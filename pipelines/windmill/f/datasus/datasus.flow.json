{
  "summary": "DATASUS (óbitos no trânsito): lago -> raw -> staging -> marts",
  "description": "Um ano por execução. Cada passo é um script Python do Windmill (f/datasus/*), editável na interface.",
  "value": {
    "modules": [
      {
        "id": "obter",
        "retry": {
          "constant": {
            "seconds": 60,
            "attempts": 3
          }
        },
        "value": {
          "path": "f/datasus/obter",
          "type": "script",
          "input_transforms": {
            "ano": {
              "expr": "flow_input.ano",
              "type": "javascript"
            },
            "pasta": {
              "expr": "flow_input.pasta",
              "type": "javascript"
            },
            "forcar": {
              "expr": "flow_input.forcar",
              "type": "javascript"
            }
          }
        },
        "summary": "Guardar o arquivo no lago"
      },
      {
        "id": "carregar",
        "value": {
          "path": "f/datasus/carregar",
          "type": "script",
          "input_transforms": {
            "ano": {
              "expr": "flow_input.ano",
              "type": "javascript"
            },
            "banco": {
              "expr": "flow_input.banco",
              "type": "javascript"
            },
            "forcar": {
              "expr": "flow_input.forcar",
              "type": "javascript"
            }
          }
        },
        "summary": "Lago -> raw.datasus_sim"
      },
      {
        "id": "transformar",
        "value": {
          "path": "f/datasus/transformar",
          "type": "script",
          "input_transforms": {
            "banco": {
              "expr": "flow_input.banco",
              "type": "javascript"
            }
          }
        },
        "summary": "dbt build (staging, testes, mart)"
      },
      {
        "id": "publicar",
        "value": {
          "path": "f/datasus/publicar",
          "type": "script",
          "input_transforms": {
            "banco": {
              "expr": "flow_input.banco",
              "type": "javascript"
            }
          }
        },
        "summary": "Marcar as cargas como publicadas"
      }
    ]
  },
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "order": [
      "ano",
      "pasta",
      "forcar",
      "banco"
    ],
    "properties": {
      "ano": {
        "type": "integer",
        "description": "Ano do arquivo do SIM",
        "default": 2023
      },
      "pasta": {
        "type": "string",
        "description": "Pasta com mortes_transito_AAAA.csv já baixado; vazio = baixar do FTP",
        "default": "/data/mortes"
      },
      "forcar": {
        "type": "boolean",
        "description": "Baixar e carregar de novo mesmo sem mudança",
        "default": false
      },
      "banco": {
        "type": "object",
        "format": "resource-postgresql",
        "description": "Banco de destino",
        "default": "$res:f/pipelines/banco_local"
      }
    },
    "required": [
      "ano",
      "banco"
    ]
  }
}
