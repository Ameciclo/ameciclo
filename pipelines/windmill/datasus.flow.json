{
  "path": "f/datasus/datasus",
  "summary": "DATASUS (óbitos no trânsito): lago -> raw -> staging -> marts",
  "description": "Os mesmos quatro passos do Dagu e do Dagster. Cada passo chama o código de pipelines/ (montado no worker).",
  "value": {
    "modules": [
      {
        "id": "obter",
        "summary": "Guardar o arquivo no lago",
        "retry": { "constant": { "attempts": 3, "seconds": 60 } },
        "value": {
          "type": "rawscript",
          "language": "bash",
          "content": "ano=\"$1\"\npasta=\"$2\"\nforcar=\"$3\"\ncd /opt/pipelines\nset -- --ano \"$ano\"\n[ -n \"$pasta\" ] && set -- \"$@\" --de-pasta \"$pasta\"\n[ \"$forcar\" = \"true\" ] && set -- \"$@\" --forcar\nexec /opt/venv/bin/python -m ingest.datasus obter \"$@\"\n",
          "input_transforms": {
            "ano": { "type": "javascript", "expr": "String(flow_input.ano)" },
            "pasta": { "type": "javascript", "expr": "flow_input.pasta" },
            "forcar": { "type": "javascript", "expr": "String(flow_input.forcar)" }
          }
        }
      },
      {
        "id": "carregar",
        "summary": "Lago -> raw.datasus_sim",
        "value": {
          "type": "rawscript",
          "language": "bash",
          "content": "ano=\"$1\"\nforcar=\"$2\"\ncd /opt/pipelines\nif [ \"$forcar\" = \"true\" ]; then exec /opt/venv/bin/python -m ingest.datasus carregar --ano \"$ano\" --forcar; fi\nexec /opt/venv/bin/python -m ingest.datasus carregar --ano \"$ano\"\n",
          "input_transforms": {
            "ano": { "type": "javascript", "expr": "String(flow_input.ano)" },
            "forcar": { "type": "javascript", "expr": "String(flow_input.forcar)" }
          }
        }
      },
      {
        "id": "transformar",
        "summary": "dbt build (staging, testes, mart)",
        "value": {
          "type": "rawscript",
          "language": "bash",
          "content": "cd /opt/pipelines\nexec /opt/venv/bin/dbt build --project-dir transform --select source:datasus+\n",
          "input_transforms": {}
        }
      },
      {
        "id": "registrar",
        "summary": "Marcar as cargas como publicadas",
        "value": {
          "type": "rawscript",
          "language": "bash",
          "content": "cd /opt/pipelines\nexec /opt/venv/bin/python -m ingest.publicar datasus.sim\n",
          "input_transforms": {}
        }
      }
    ]
  },
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "ano": { "type": "integer", "description": "Ano do arquivo do SIM", "default": 2023 },
      "pasta": { "type": "string", "description": "Pasta com mortes_transito_AAAA.csv já baixado; vazio = baixar do FTP", "default": "/data/mortes" },
      "forcar": { "type": "boolean", "description": "Baixar e carregar de novo mesmo sem mudança", "default": false }
    },
    "required": ["ano"]
  }
}
