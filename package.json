{
  "name": "ameciclo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @ameciclo/web dev",
    "dev:admin": "pnpm --filter @ameciclo/admin dev",
    "build": "pnpm -r --if-present build",
    "lint": "oxlint",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:generate": "pnpm --filter @ameciclo/db db:generate",
    "db:migrate": "pnpm --filter @ameciclo/db db:migrate",
    "db:studio": "pnpm --filter @ameciclo/db db:studio"
  },
  "devDependencies": {
    "oxlint": "^1.62.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver",
      "workerd"
    ]
  }
}
