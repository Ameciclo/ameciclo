{
  "name": "ameciclo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @ameciclo/web dev",
    "dev:admin": "pnpm --filter @ameciclo/admin dev",
    "build": "pnpm -r --if-present build",
    "lint": "oxlint",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:generate": "pnpm --filter @ameciclo/db db:generate",
    "db:migrate": "pnpm --filter @ameciclo/db db:migrate",
    "db:studio": "pnpm --filter @ameciclo/db db:studio",
    "db:import": "pnpm --filter @ameciclo/db db:import",
    "db:seed": "pnpm --filter @ameciclo/db db:seed"
  },
  "devDependencies": {
    "oxlint": "^1.94.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver",
      "workerd"
    ],
    "overrides": {
      "seroval": ">=1.6.8",
      "vite": "^7.3.8",
      "postcss": ">=8.5.23",
      "nanoid@<3.3.18": ">=3.3.18",
      "source-map-js": ">=1.2.2",
      "brace-expansion@<2.1.7": ">=2.1.7",
      "qs": ">=6.16.1",
      "uuid@<11.1.1": ">=11.1.1",
      "esbuild@<0.28.1": ">=0.28.1",
      "zod": "^4.6.7",
      "js-yaml@>=4.0.0": ">=4.3.2",
      "browserslist": ">=4.28.7",
      "baseline-browser-mapping": ">=2.11.0",
      "@babel/core": ">=7.29.6"
    }
  }
}
