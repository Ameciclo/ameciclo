{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ameciclo-admin",
  "account_id": "8b9af9b81476222e1a787f42f3c8076a",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [{ "pattern": "admin.ameciclo.org", "custom_domain": true }],
  "compatibility_date": "2026-03-17",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "placement": { "mode": "smart" },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "eed191a13be64878a7963d325b53c565",
      // Used only by `vite dev`; the docker-compose Postgres.
      "localConnectionString": "postgres://ameciclo:ameciclo@localhost:5433/ameciclo",
    },
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client",
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  "env": {
    "staging": {
      "routes": [{ "pattern": "staging-admin.ameciclo.org", "custom_domain": true }],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "REPLACE_WITH_STAGING_HYPERDRIVE_ID",
          "localConnectionString": "postgres://ameciclo:ameciclo@localhost:5433/ameciclo",
        },
      ],
    },
  },
}
