{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ameciclo-sync",
  "account_id": "8b9af9b81476222e1a787f42f3c8076a",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  // Waiting on Overpass costs no CPU; this is for parsing the answers and
  // writing them to Postgres in the last step.
  "limits": { "cpu_ms": 300000 },
  "observability": { "logs": { "enabled": true, "invocation_logs": true } },
  "vars": { "ENVIRONMENT": "production" },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "eed191a13be64878a7963d325b53c565",
      // Used only by `wrangler dev`; the docker-compose Postgres.
      "localConnectionString": "postgres://ameciclo:ameciclo@localhost:5433/ameciclo",
    },
  ],
  "r2_buckets": [
    { "binding": "OSM_BUCKET", "bucket_name": "ameciclo-cycling-osm" },
  ],
  "workflows": [
    {
      "name": "ameciclo-sync-ciclo",
      "binding": "CICLO_SYNC",
      "class_name": "CicloSync",
      // Mondays 07:00 UTC (04:00 in Recife).
      "schedules": ["0 7 * * 1"],
    },
  ],

  "env": {
    "staging": {
      "name": "ameciclo-sync-staging",
      "vars": { "ENVIRONMENT": "staging" },
      "hyperdrive": [
        { "binding": "HYPERDRIVE", "id": "bb7f4a59e3aa4a86967d79c30de81e93" },
      ],
      "r2_buckets": [
        { "binding": "OSM_BUCKET", "bucket_name": "ameciclo-cycling-osm" },
      ],
      // No schedule: staging only runs when someone triggers it.
      "workflows": [
        {
          "name": "ameciclo-sync-ciclo-staging",
          "binding": "CICLO_SYNC",
          "class_name": "CicloSync",
        },
      ],
    },
  },
}
